{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm --prefix scrollcheck/frontend install",
  "buildCommand": "npm --prefix scrollcheck/frontend run build",
  "outputDirectory": "scrollcheck/frontend/dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.py" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
